<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Nullable stays off: the game API surface (Assembly-CSharp, UnityEngine)
         is unannotated and ~34 CS8600-class findings fire tree-wide today.
         Enable only after a dedicated null-safety pass annotates or guards
         those sites; TreatWarningsAsErrors would otherwise block every build. -->
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>EfficientServer</AssemblyName>
    <RootNamespace>EfficientServer</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(EfficientServerOutput)</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Keep the DLL byte-identical across rebuilds: no embedded timestamps or
         absolute build paths in metadata. -->
    <Deterministic>true</Deterministic>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- Records the restore graph in packages.lock.json (contentHash per
         package) next to the test project's, so the one NuGet input this build
         fetches is hash-pinned once the file is committed. A fresh tree has no
         lock file yet: restore writes one, which is then committed like any
         other reviewed dependency change. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The SDK pulls these in implicitly for a net48 target on a non-Windows
         host, with versions the SDK chooses, so every `make build` fetches
         whatever nuget.org currently serves. Declaring them here with exact
         ranges (brackets, like Newtonsoft.Json in the test project) makes the
         reference assemblies a reviewed, pinned input instead of a float. They
         supply reference metadata only, so they cannot change the emitted IL.
         Bump = reviewed change of these strings, like global.json's SDK pin.

         The parent is the one that needed the explicit entry to be pinned: the
         SDK adds it as a bare `Version="1.0.3"`, which NuGet normalizes to the
         open range [1.0.3, ), so a restore that is not in locked mode can float
         it to any 1.x. The SDK only adds that implicit reference when no
         PackageReference with this identity is already present
         (Microsoft.NET.Sdk.FrameworkReferenceResolution.targets checks
         _ExistingReferenceAssembliesPackageReference), so declaring it here
         overrides the implicit one instead of duplicating it. Keep the two
         versions in step: the parent 1.0.3 depends on the leaf 1.0.3. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="[1.0.3]" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="[1.0.3]" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameManagedDir)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Provides global::Log (EsLog.Emit wraps Log.Out); no using directive
         exists for it, so grep cannot see this dependency. -->
    <Reference Include="LogLibrary">
      <HintPath>$(GameManagedDir)/LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AstarPathfindingProject">
      <HintPath>$(GameManagedDir)/AstarPathfindingProject.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
