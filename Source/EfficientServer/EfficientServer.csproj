<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Nullable stays off: the game API surface (Assembly-CSharp, UnityEngine)
         is unannotated and ~34 CS8600-class findings fire tree-wide today.
         Enable only after a dedicated null-safety pass annotates or guards
         those sites; TreatWarningsAsErrors would otherwise block every build. -->
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>EfficientServer</AssemblyName>
    <RootNamespace>EfficientServer</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(EfficientServerOutput)</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Keep the DLL byte-identical across rebuilds: no embedded timestamps or
         absolute build paths in metadata. -->
    <Deterministic>true</Deterministic>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameManagedDir)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Provides global::Log (ModApi.Log wraps Log.Out); no using directive
         exists for it, so grep cannot see this dependency. -->
    <Reference Include="LogLibrary">
      <HintPath>$(GameManagedDir)/LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AstarPathfindingProject">
      <HintPath>$(GameManagedDir)/AstarPathfindingProject.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
