<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-contained self-check for Config.Load / Config.Normalize. Config.cs has no
    game-type dependencies (only EsLog, mirrored in EsLogStub.cs because the real one
    calls the game's global::Log, plus Newtonsoft), so this runs natively on the
    .NET SDK - no net48/Mono host or game DLLs needed. Assert harness rather than a
    test framework so it builds and runs offline.
    Run it with: dotnet run in this project directory.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Harness only: run on whatever newer runtime the host has (e.g. net10-only
         boxes) instead of failing with a missing-framework error in `make test`. -->
    <RollForward>LatestMajor</RollForward>
    <!-- Nullable on: the compiled subset (Config.cs, TickClock.cs,
         TickIntervalEma.cs, this project) passes clean. The main net48 project
         keeps it off until the game-API interop sites are annotated; see
         EfficientServer.csproj. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>EfficientServer.Tests</AssemblyName>
    <RootNamespace>EfficientServer.Tests</RootNamespace>
    <!-- Commit packages.lock.json (hash-pinned graph) and restore it with
         locked mode (Makefile test) so dependency changes must go through a
         regenerated lock file, like Cargo.lock. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test the real source directly; no game-type coupling in these files.
         This list is the ONLY coupling between the two projects, and it is
         hand-maintained: a new game-type-free module in EfficientServer/ gets
         no coverage until it is added here, and nothing fails when it is
         forgotten. Keep it in step with any new game-type-free file. -->
    <Compile Include="../EfficientServer/Config.cs" />
    <!-- Fail-open degradation registry: announce-once, count-every, and the
         `es status` summary format the console command renders. -->
    <Compile Include="../EfficientServer/Degrade.cs" />
    <!-- Log record shape shared by the real EsLog and the stub above: one line
         per record (an embedded exception must not split into untimestamped
         continuations) and the uptime stamp every record carries. -->
    <Compile Include="../EfficientServer/LogLine.cs" />
    <!-- Game-type-free apply-chain runner: per-step failure isolation, so one
         throwing lever cannot skip the rest of a start-time or reload chain, and
         the collected failures are still reported rather than swallowed. -->
    <Compile Include="../EfficientServer/ApplyChain.cs" />
    <!-- Game-type-free clock seam: the EMA the governor and tick guard key off,
         driven here with explicit timestamps instead of a live Stopwatch. -->
    <Compile Include="../EfficientServer/Patches/TickIntervalEma.cs" />
    <!-- Game-type-free governor tier machine: hysteresis, windows, cooldown and
         the lever math, separated from the GameManager postfix that drives it. -->
    <Compile Include="../EfficientServer/Patches/GovernorTiers.cs" />
    <!-- Game-type-free tick counter behind the per-entity LOD stripes; the
         coverage invariant (every entity owns exactly one slot per stride
         window, at any tick sampling) is what keeps distant zombies' AI and
         collision resolution alive under Server.TargetFps > 20. -->
    <Compile Include="../EfficientServer/Patches/TickClock.cs" />
    <!-- Game-type-free shed selector: which entity ids a tick-guard batch
         removes. Distance alone is not a total order, so the id tie-break (and
         with it replay-stable batches) is pinned here. -->
    <Compile Include="../EfficientServer/Patches/ShedOrder.cs" />
    <!-- Game-type-free host-type gate: the once-per-process dedicated-server
         answer every patch prefix reads, on the main thread and on the
         LiteNetLib receive thread. Game-type-free, so the resolve-once
         publication and its concurrent resolvers are pinned here. -->
    <Compile Include="../EfficientServer/Patches/DedicatedHostGate.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exact range pin: a bare Version="13.0.4" restores as [13.0.4, ),
         so any non-locked restore floats to the newest 13.x+. SECURITY.md
         promises an exact pin; brackets deliver it. Bump = reviewed change
         of this string + regenerated lock file, like global.json's SDK. -->
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.4]" />
  </ItemGroup>

</Project>
