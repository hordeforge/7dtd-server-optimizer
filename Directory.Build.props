<Project>
  <!-- Shared analyzer/compiler strictness for all projects in this tree.
       Both flags are proven clean by the current build: 0 warnings under
       TreatWarningsAsErrors, no IDE0055 formatting violations under
       EnforceCodeStyleInBuild (rules from .editorconfig). Any future warning
       fails the build instead of scrolling by unread. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Pinned so an SDK update cannot silently change the enabled analyzer
         set; a bump must be reviewed like any dependency change. An explicit
         8.0, not "latest": global.json's rollForward=latestPatch still admits
         a newer 8.0.4xx, and AnalysisLevel=latest tracks whichever SDK resolved,
         so the analyzer set would drift without any change here. -->
    <AnalysisLevel>8.0</AnalysisLevel>
    <!-- AnalysisMode stays at its default (rules whose severity is warning
         or error only), which is the strictest mode this tree passes today.
         Measured on SDK 8.0.424 over Source/EfficientServer.Tests, the only
         project buildable without a game install (it compiles Config.cs,
         TickClock.cs, TickIntervalEma.cs, GovernorTiers.cs, Program.cs and
         Fuzz.cs), with TreatWarningsAsErrors off so every finding is counted:

           AnalysisMode=Recommended  34 findings  CA1805 CA1310 CA1825
           AnalysisMode=All         138 findings  those three plus CA5394,
                                                 CA1307, CA1031, CA1303,
                                                 CA1508, CA2000, CA1002

         A game install would add the other 32 source files to the probe, so
         the tree-wide count is higher than the one above; the conclusion does
         not change, since Recommended is already red on the subset alone.
         Per-rule is the way forward, not a mode bump: flip an individual rule
         to warning-as-error in this file once the findings it reports are
         gone, so each tightening is proven by the build that enforces it. -->
  </PropertyGroup>
</Project>
