<Project>
  <!-- Shared analyzer/compiler strictness for all projects in this tree.
       Both flags are proven clean by the current build: 0 warnings under
       TreatWarningsAsErrors, no IDE0055 formatting violations under
       EnforceCodeStyleInBuild (rules from .editorconfig). Any future warning
       fails the build instead of scrolling by unread. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Pinned so an SDK update cannot silently change the enabled analyzer
         set; a bump must be reviewed like any dependency change. An explicit
         8.0, not "latest": global.json's rollForward=latestPatch still admits
         a newer 8.0.4xx, and AnalysisLevel=latest tracks whichever SDK resolved,
         so the analyzer set would drift without any change here. -->
    <AnalysisLevel>8.0</AnalysisLevel>
    <!-- AnalysisMode stays at its default (rules whose severity is warning
         or error only). A measured probe of AllEnabledByDefault fails on
         ~160 pre-existing findings (CA1031 broad catches, CA1805 explicit
         default initializers, CA5394 deserialization in the fuzz harness),
         so enabling it here would turn every build red; tighten per-rule
         once those are resolved instead. -->
  </PropertyGroup>
</Project>
