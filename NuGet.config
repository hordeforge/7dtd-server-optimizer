<?xml version="1.0" encoding="utf-8"?>
<!-- Restore sources for the whole tree, pinned in-repo.

     NuGet otherwise layers every config from the drive root down, so a
     machine-level or user-level feed (~/.nuget/NuGet/NuGet.Config) can add
     a source this project never declared. The test project's single
     PackageReference is exact-pinned and hash-pinned in
     Source/EfficientServer.Tests/packages.lock.json, so a rogue feed would
     still have to serve a matching sha512 to win; <clear/> removes the
     fallback entirely instead of relying on that second line of defense.

     The main mod project has no PackageReference at all: every third-party
     DLL (Assembly-CSharp, 0Harmony, Newtonsoft.Json, Unity, LogLibrary,
     AstarPathfindingProject) is a Private=false Reference resolved from the
     dedicated server's own Managed/ directory, so nothing is fetched for it.

     `dotnet tool restore` (.config/dotnet-tools.json, dotnet-coverage) reads
     this file too. A new source is a reviewed change, like a new
     PackageReference. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
